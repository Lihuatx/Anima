{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anima",
  "version": "0.1.0",
  "identifier": "dev.anima.desktop-pet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Anima Pet",
        "width": 360,
        "height": 640,
        "minWidth": 260,
        "minHeight": 420,
        "resizable": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "center": true
      },
      {
        "label": "chat",
        "title": "Anima Chat",
        "width": 360,
        "height": 430,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
